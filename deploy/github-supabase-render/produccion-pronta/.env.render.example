# Render API service: facturd-api-produccion
# Usar un proyecto Supabase separado de pruebas.
# Preferir Pooler Session. Convertir postgres:// a postgresql+psycopg2://.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:SUPABASE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=CAMBIAR_POR_CLAVE_LARGA_UNICA_DE_PRODUCCION
CORS_ORIGINS=https://app.tu-dominio.com
AUTO_CREATE_TABLES=false

# Render Static Site: facturd-frontend-produccion
VITE_API_URL=https://api.tu-dominio.com/api
