# Render API service: facturd-api-pruebas
# Usar el connection string de Supabase Pooler Session.
# Convertir el prefijo a postgresql+psycopg2:// si Supabase lo entrega como postgres://.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:SUPABASE_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=CAMBIAR_POR_CLAVE_LARGA_PARA_PRUEBAS
CORS_ORIGINS=https://facturd-frontend-pruebas.onrender.com
AUTO_CREATE_TABLES=false

# Render Static Site: facturd-frontend-pruebas
VITE_API_URL=https://facturd-api-pruebas.onrender.com/api
